# App
PORT=4000
POLICY=L2
NODE_ENV=development

# ── Google Cloud Storage ─────────────────────────────────────────────────────
GCS_BUCKET=
GCS_PREFIX=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./server/gcs-key.json


# xAPI LRS
XAPI_LRS_ENDPOINT=
XAPI_LRS_USERNAME=
XAPI_LRS_PASSWORD=
XAPI_LRS_KEY=
XAPI_LRS_SECRET=
XAPI_VERSION=1.0.3
XAPI_AUTH_TYPE=basic

# Teacher role
TEACHER_EMAILS=

# LLM routing
LLM_VENDOR=openai
LLM_MODEL=
LLM_TIMEOUT_MS=60000

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# Google Gemini / Vertex-compatible Gemini API
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_AI_MODEL=

# AWS Bedrock placeholder
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=

# Cohere
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Together AI
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=

# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=

# Local / custom OpenAI-compatible servers
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
