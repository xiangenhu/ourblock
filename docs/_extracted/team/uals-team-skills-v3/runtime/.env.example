# ── @uals/skill-runtime — environment contract ──────────────────────────────
# Every runtime module reads config from here (via src/config.js). Required vars
# fail loud at mount(); optional features silently no-op when their vars are absent.

# App identity
APP_SLUG=app                         # namespace for help locationId + bug appId joins
APP_URL=https://your-app.example     # xAPI extension key prefix (bug statements)
NODE_ENV=production
PORT=3000

# GCS — the ONE persistence layer (REQUIRED; project invariant: no local/other DB)
GCP_PROJECT_ID=your-gcp-project
GCS_BUCKET_NAME=your-bucket          # REQUIRED
# GCS_KEY_FILE=./sa.json             # LOCAL DEV ONLY — on Cloud Run use ADC (omit this)

# Unified LLM gateway (REQUIRED for help/content)
LLM_GATEWAY_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_GATEWAY_API_KEY=sk-...           # or set OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400

# Learning Record Store (team-xapi) — SEPARATE from the bug LRS
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=

# Bug telemetry LRS (team-bugfix) — intentionally separate; no-ops if unset (local dev)
BUG_LRS_ENDPOINT=
BUG_LRS_USERNAME=
BUG_LRS_PASSWORD=
BUG_APP_ID=default

# Contextual help
HELP_HOVER_DWELL_MS=3000             # 0 disables auto-open globally
# HELP_GROUNDING_GCS_PATH=grounding/brief.md   # optional grounding doc in GCS

# Text-to-speech (optional) — Read-aloud chips appear only if set
# OPENAI_API_KEY=sk-...
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy

# i18n (hash-based; registry lives in GCS)
LANG_COOKIE=lang
# I18N_REGISTRY_GCS_PATH=i18n/registry.json
# BUG_FIXLOG_GCS_PATH=cache/bugfix/log.json

# LLM cost prices (USD per 1M tokens) for accounting. PRICES CHANGE — keep current.
# LLM_PRICES={"gpt-4o-mini":{"in":0.15,"out":0.60},"gpt-4o":{"in":2.5,"out":10},"*":{"in":0.5,"out":1.5}}
# USAGE_GCS_PREFIX defaults to usage/{date}/{userId}.json

# LLM variant-pool cache (the "CACHE_MAX copies" design)
LLM_CACHE_BACKEND=gcs                 # gcs (recommended) | lrs | off
LLM_CACHE_DEFAULT=false               # cache every gateway call unless a call opts out
CACHE_MAX=3                           # max response variants kept per unique request hash
LLM_CACHE_TTL_DAYS=7
# backend=lrs only — a DEDICATED cache LRS (never the learning LRS):
# LLM_CACHE_LRS_ENDPOINT=
# LLM_CACHE_LRS_USERNAME=
# LLM_CACHE_LRS_PASSWORD=
