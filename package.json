{
  "name": "ourblock",
  "version": "1.0.0",
  "description": "优城美市 · Our Block — a place-based civic wellbeing app",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "kill": "pkill -f 'server/index.js' || echo 'no Our Block server running'",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --reset",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
}
